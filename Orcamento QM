    background: ${CORES.bg};
    border: 1px solid ${CORES.border};
    border-radius: 8px;
    color: ${CORES.text};
    font-family: 'JetBrains Mono', monospace;
    font-size: 14px;
    padding: 10px 12px;
    outline: none;
    transition: border-color 0.2s;
    width: 100%;
    appearance: none;
    -webkit-appearance: none;
  }
  .form-group input:focus,
  .form-group select:focus { border-color: ${CORES.accent}; box-shadow: 0 0 0 3px ${CORES.accentGlow}; }
  .form-group input::placeholder { color: ${CORES.textMuted}; }

  /* TOGGLE TYPE */
  .toggle-group {
    display: flex; gap: 8px; flex-wrap: wrap;
  }
  .toggle-btn {
    padding: 8px 16px;
    border-radius: 8px;
    border: 1px solid ${CORES.border};
    background: transparent;
    color: ${CORES.textMuted};
    font-family: 'Syne', sans-serif;
    font-size: 13px; font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }
  .toggle-btn.active {
    border-color: ${CORES.accent};
    background: ${CORES.accentSoft};
    color: ${CORES.accent};
  }
  .toggle-btn:hover:not(.active) { border-color: ${CORES.textMuted}; color: ${CORES.text}; }

  /* MEDIDOR LIST */
  .med-list { display: flex; flex-direction: column; gap: 8px; margin-top: 12px; }
  .med-item {
    display: flex; align-items: center; justify-content: space-between;
    background: ${CORES.bg};
    border: 1px solid ${CORES.border};
    border-radius: 8px;
    padding: 10px 14px;
    font-family: 'JetBrains Mono', monospace;
    font-size: 13px;
  }
  .med-item-info { display: flex; align-items: center; gap: 10px; }
  .med-badge {
    padding: 2px 8px; border-radius: 4px;
    font-size: 11px; font-weight: 700; text-transform: uppercase;
  }
  .badge-mono { background: #1a3a5c; color: #58a6ff; }
  .badge-bi   { background: #2d2a1a; color: #e3b341; }
  .badge-tri  { background: #1a2d1a; color: ${CORES.green}; }
  .badge-din  { background: #2d1a2d; color: #bc8cff; }
  .badge-cm   { background: #2d1a1a; color: ${CORES.red}; }
  .med-remove {
    background: none; border: none; color: ${CORES.textMuted};
    cursor: pointer; font-size: 16px; padding: 0 4px;
    transition: color 0.2s;
  }
  .med-remove:hover { color: ${CORES.red}; }

  /* ADD BUTTON */
  .btn-add {
    display: flex; align-items: center; gap: 8px;
    background: ${CORES.accentSoft};
    border: 1px dashed ${CORES.accent};
    border-radius: 8px;
    color: ${CORES.accent};
    font-family: 'Syne', sans-serif;
    font-size: 13px; font-weight: 700;
    padding: 10px 16px;
    cursor: pointer;
    width: 100%;
    justify-content: center;
    margin-top: 8px;
    transition: all 0.2s;
  }
  .btn-add:hover { background: ${CORES.accent}; color: #000; }

  /* CHECKBOX */
  .check-row {
    display: flex; align-items: center; gap: 10px;
    cursor: pointer; padding: 10px 0;
  }
  .check-row input[type=checkbox] {
    width: 18px; height: 18px; accent-color: ${CORES.accent};
    cursor: pointer;
  }
  .check-row span { font-size: 14px; }

  /* NAVIGATION */
  .nav-buttons {
    display: flex; gap: 10px; margin-top: 20px;
  }
  .btn-back {
    padding: 12px 24px;
    border-radius: 8px;
    border: 1px solid ${CORES.border};
    background: transparent;
    color: ${CORES.textMuted};
    font-family: 'Syne', sans-serif;
    font-size: 14px; font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }
  .btn-back:hover { border-color: ${CORES.text}; color: ${CORES.text}; }
  .btn-next {
    flex: 1;
    padding: 12px 24px;
    border-radius: 8px;
    border: none;
    background: ${CORES.accent};
    color: #000;
    font-family: 'Syne', sans-serif;
    font-size: 14px; font-weight: 800;
    cursor: pointer;
    transition: all 0.2s;
    letter-spacing: 0.5px;
  }
  .btn-next:hover { filter: brightness(1.1); transform: translateY(-1px); }

  /* RESULTADO */
  .result-header {
    display: flex; justify-content: space-between; align-items: flex-start;
    margin-bottom: 24px; flex-wrap: wrap; gap: 12px;
  }
  .result-title { font-size: 20px; font-weight: 800; }
  .result-subtitle { font-size: 13px; color: ${CORES.textMuted}; margin-top: 2px; }

  .price-cards {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 12px; margin-bottom: 24px;
  }
  .price-card {
    background: ${CORES.bg};
    border: 1px solid ${CORES.border};
    border-radius: 10px;
    padding: 16px;
  }
  .price-card.highlight { border-color: ${CORES.accent}; background: ${CORES.accentSoft}; }
  .price-card label {
    font-size: 11px; text-transform: uppercase; letter-spacing: 1px;
    color: ${CORES.textMuted}; font-weight: 700; display: block; margin-bottom: 6px;
  }
  .price-card.highlight label { color: ${CORES.accent}; }
  .price-card .value {
    font-family: 'JetBrains Mono', monospace;
    font-size: 22px; font-weight: 700;
  }
  .price-card.highlight .value { color: ${CORES.accent}; }

  /* TABELA */
  .itens-table { width: 100%; border-collapse: collapse; font-size: 13px; }
  .itens-table th {
    text-align: left; padding: 8px 12px;
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.8px;
    color: ${CORES.textMuted}; font-weight: 700;
    border-bottom: 1px solid ${CORES.border};
  }
  .itens-table td {
    padding: 9px 12px;
    border-bottom: 1px solid ${CORES.border}40;
    vertical-align: middle;
  }
  .itens-table tr:last-child td { border-bottom: none; }
  .itens-table tr:hover td { background: ${CORES.surfaceHover}; }
  .cat-badge {
    display: inline-block; padding: 2px 8px; border-radius: 4px;
    font-size: 10px; font-weight: 700; text-transform: uppercase;
    background: ${CORES.accentSoft}; color: ${CORES.accent};
  }
  .qty-mono { font-family: 'JetBrains Mono', monospace; color: ${CORES.textMuted}; }
  .preco-total { font-family: 'JetBrains Mono', monospace; font-weight: 700; text-align: right; }

  /* PRINT */
  .btn-print {
    display: flex; align-items: center; gap: 8px;
    padding: 11px 20px; border-radius: 8px;
    border: 1px solid ${CORES.border};
    background: transparent; color: ${CORES.text};
    font-family: 'Syne', sans-serif;
    font-size: 13px; font-weight: 700;
    cursor: pointer; transition: all 0.2s;
  }
  .btn-print:hover { border-color: ${CORES.accent}; color: ${CORES.accent}; }

  /* EMPTY */
  .empty-state {
    text-align: center; padding: 40px;
    color: ${CORES.textMuted}; font-size: 14px;
  }
  .empty-state div { font-size: 32px; margin-bottom: 12px; }

  /* SEPARATOR */
  .sep { height: 1px; background: ${CORES.border}; margin: 16px 0; }

  /* CAT SECTION */
  .cat-section { margin-bottom: 4px; }
  .cat-header {
    padding: 6px 12px;
    font-size: 11px; text-transform: uppercase; letter-spacing: 1px;
    color: ${CORES.textMuted}; font-weight: 700;
    background: ${CORES.bg};
  }

  @media print {
    body { background: white; color: black; }
    .steps, .nav-buttons, .btn-print, .btn-next, .btn-back { display: none !important; }
    .card { border: 1px solid #ccc; }
    .price-card { border: 1px solid #ccc; }
  }

  @media (max-width: 600px) {
    .steps { flex-direction: column; }
    .step-tab { justify-content: flex-start; }
    .form-row { grid-template-columns: 1fr; }
  }
`;

// ============================================================
// OPÇÕES DINÂMICAS
// ============================================================
const OPCOES_TIPO_GERAL = ["din", "cm"];
const OPCOES_AMP_GERAL = {
  din: ["50A", "63A", "70A"],
  cm:  ["80A", "90A", "100A", "125A", "150A", "175A", "200A", "225A", "250A"],
};
const OPCOES_TIPO_MED = ["mono", "bi", "tri"];
const OPCOES_AMP_MED = {
  mono: ["40A", "50A", "63A"],
  bi:   ["40A", "50A", "63A"],
  tri:  ["50A", "63A", "70A"],
};

function fmt(v) {
  return v.toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
}

// ============================================================
// APP PRINCIPAL
// ============================================================
export default function App() {
  const [etapa, setEtapa] = useState(1);

  // Config
  const [cliente, setCliente] = useState({ nome: "", cpfCnpj: "", endereco: "" });
  const [tipoQuadro, setTipoQuadro] = useState("policarb");
  const [qtdMedidores, setQtdMedidores] = useState(6);
  const [disjuntorGeral, setDisjuntorGeral] = useState({ tipo: "din", amperagem: "70A", qty: 1 });
  const [medidores, setMedidores] = useState([]);
  const [novoMed, setNovoMed] = useState({ tipo: "mono", amperagem: "40A", qty: 1 });
  const [dps, setDps] = useState("");
  const [incluirBarramento, setIncluirBarramento] = useState(true);
  const [incluirMO, setIncluirMO] = useState(true);

  // Resultado
  const [resultado, setResultado] = useState(null);

  const addMedidor = () => {
    if (!novoMed.tipo || !novoMed.amperagem) return;
    setMedidores(p => [...p, { ...novoMed }]);
  };

  const removeMedidor = (idx) => {
    setMedidores(p => p.filter((_, i) => i !== idx));
  };

  const calcular = useCallback(() => {
    const res = calcularOrcamento({
      tipoQuadro, qtdMedidores, disjuntorGeral, medidores,
      dps, incluirBarramento, incluirMO,
    });
    setResultado(res);
    setEtapa(4);
  }, [tipoQuadro, qtdMedidores, disjuntorGeral, medidores, dps, incluirBarramento, incluirMO]);

  // Agrupamento por categoria
  const categorias = resultado
    ? [...new Set(resultado.itens.map(i => i.categoria))]
    : [];

  const LABEL_TIPO = { mono: "Mono", bi: "Bi", tri: "Tri", din: "Din", cm: "CM" };

  return (
    <>
      <style>{css}</style>
      <div className="app">
        {/* HEADER */}
        <div className="header">
          <div className="header-icon">⚡</div>
          <div>
            <h1>QM Elétrico — Orçamento</h1>
            <span>Quadro de Medição Coletiva · Policarbonato & Alumínio</span>
          </div>
        </div>

        {/* TABS */}
        <div className="steps">
          {[
            { n: 1, label: "Projeto" },
            { n: 2, label: "Medidores" },
            { n: 3, label: "Extras" },
            { n: 4, label: "Orçamento" },
          ].map(s => (
            <button
              key={s.n}
              className={`step-tab ${etapa === s.n ? "active" : ""} ${etapa > s.n ? "done" : ""}`}
              onClick={() => s.n < etapa || etapa === 4 ? setEtapa(s.n) : null}
            >
              <span className="step-num">{etapa > s.n ? "✓" : s.n}</span>
              {s.label}
            </button>
          ))}
        </div>

        {/* ======================== ETAPA 1 ======================== */}
        {etapa === 1 && (
          <>
            <div className="card">
              <div className="card-title">Dados do Cliente</div>
              <div className="form-row">
                <div className="form-group">
                  <label>Nome do Cliente</label>
                  <input value={cliente.nome} onChange={e => setCliente(p => ({ ...p, nome: e.target.value }))} placeholder="Ex: João Silva" />
                </div>
                <div className="form-group">
                  <label>CPF / CNPJ</label>
                  <input value={cliente.cpfCnpj} onChange={e => setCliente(p => ({ ...p, cpfCnpj: e.target.value }))} placeholder="000.000.000-00" />
                </div>
              </div>
              <div className="form-row">
                <div className="form-group">
                  <label>Endereço da Obra</label>
                  <input value={cliente.endereco} onChange={e => setCliente(p => ({ ...p, endereco: e.target.value }))} placeholder="Rua, número, cidade" />
                </div>
              </div>
            </div>

            <div className="card">
              <div className="card-title">Tipo de Quadro</div>
              <div className="toggle-group" style={{ marginBottom: 20 }}>
                <button className={`toggle-btn ${tipoQuadro === "policarb" ? "active" : ""}`} onClick={() => setTipoQuadro("policarb")}>🔲 Policarbonato</button>
                <button className={`toggle-btn ${tipoQuadro === "aluminio" ? "active" : ""}`} onClick={() => setTipoQuadro("aluminio")}>🔩 Alumínio</button>
              </div>

              <div className="form-row">
                <div className="form-group">
                  <label>Qtd. Medidores</label>
                  <select value={qtdMedidores} onChange={e => setQtdMedidores(Number(e.target.value))}>
                    {[2,3,4,6,9,12,15,18,21,24,27,30,33,36].map(n => (
                      <option key={n} value={n}>{n} medidores</option>
                    ))}
                  </select>
                </div>
              </div>
            </div>

            <div className="card">
              <div className="card-title">Disjuntor Geral (a montante)</div>
              <div className="form-row">
                <div className="form-group">
                  <label>Tipo</label>
                  <div className="toggle-group">
                    <button className={`toggle-btn ${disjuntorGeral.tipo === "din" ? "active" : ""}`}
                      onClick={() => setDisjuntorGeral(p => ({ ...p, tipo: "din", amperagem: "70A" }))}>Din</button>
                    <button className={`toggle-btn ${disjuntorGeral.tipo === "cm" ? "active" : ""}`}
                      onClick={() => setDisjuntorGeral(p => ({ ...p, tipo: "cm", amperagem: "100A" }))}>CM (medidor)</button>
                  </div>
                </div>
                <div className="form-group">
                  <label>Amperagem</label>
                  <select value={disjuntorGeral.amperagem}
                    onChange={e => setDisjuntorGeral(p => ({ ...p, amperagem: e.target.value }))}>
                    {(OPCOES_AMP_GERAL[disjuntorGeral.tipo] || []).map(a => (
                      <option key={a} value={a}>{a}</option>
                    ))}
                  </select>
                </div>
              </div>
            </div>

            <div className="nav-buttons">
              <button className="btn-next" onClick={() => setEtapa(2)}>Próximo →</button>
            </div>
          </>
        )}

        {/* ======================== ETAPA 2 ======================== */}
        {etapa === 2 && (
          <>
            <div className="card">
              <div className="card-title">Adicionar Medidor</div>
              <div className="form-row">
                <div className="form-group">
                  <label>Tipo</label>
                  <div className="toggle-group">
                    {OPCOES_TIPO_MED.map(t => (
                      <button key={t} className={`toggle-btn ${novoMed.tipo === t ? "active" : ""}`}
                        onClick={() => setNovoMed(p => ({ ...p, tipo: t, amperagem: OPCOES_AMP_MED[t][0] }))}>
                        {t === "mono" ? "Mono" : t === "bi" ? "Bi" : "Tri"}
                      </button>
                    ))}
                  </div>
                </div>
                <div className="form-group">
                  <label>Amperagem</label>
                  <select value={novoMed.amperagem} onChange={e => setNovoMed(p => ({ ...p, amperagem: e.target.value }))}>
                    {(OPCOES_AMP_MED[novoMed.tipo] || []).map(a => (
                      <option key={a} value={a}>{a}</option>
                    ))}
                  </select>
                </div>
                <div className="form-group" style={{ maxWidth: 120 }}>
                  <label>Qtd.</label>
                  <select value={novoMed.qty} onChange={e => setNovoMed(p => ({ ...p, qty: Number(e.target.value) }))}>
                    {Array.from({ length: 36 }, (_, i) => i + 1).map(n => (
                      <option key={n} value={n}>{n}</option>
                    ))}
                  </select>
                </div>
              </div>
              <button className="btn-add" onClick={addMedidor}>＋ Adicionar</button>
            </div>

            {medidores.length > 0 ? (
              <div className="card">
                <div className="card-title">Medidores Adicionados</div>
                <div className="med-list">
                  {medidores.map((m, i) => (
                    <div className="med-item" key={i}>
                      <div className="med-item-info">
                        <span className={`med-badge badge-${m.tipo}`}>{LABEL_TIPO[m.tipo]}</span>
                        <span style={{ fontWeight: 700 }}>{m.amperagem}</span>
                        <span style={{ color: CORES.textMuted }}>×{m.qty}</span>
                      </div>
                      <button className="med-remove" onClick={() => removeMedidor(i)}>×</button>
                    </div>
                  ))}
                </div>
              </div>
            ) : (
              <div className="card">
                <div className="empty-state">
                  <div>📋</div>
                  Nenhum medidor adicionado ainda
                </div>
              </div>
            )}

            <div className="nav-buttons">
              <button className="btn-back" onClick={() => setEtapa(1)}>← Voltar</button>
              <button className="btn-next" onClick={() => setEtapa(3)}>Próximo →</button>
            </div>
          </>
        )}

        {/* ======================== ETAPA 3 ======================== */}
        {etapa === 3 && (
          <>
            <div className="card">
              <div className="card-title">DPS — Dispositivo de Proteção</div>
              <div className="toggle-group">
                <button className={`toggle-btn ${dps === "" ? "active" : ""}`} onClick={() => setDps("")}>Sem DPS</button>
                <button className={`toggle-btn ${dps === "classeI" ? "active" : ""}`} onClick={() => setDps("classeI")}>Classe I</button>
                <button className={`toggle-btn ${dps === "classeII" ? "active" : ""}`} onClick={() => setDps("classeII")}>Classe II</button>
              </div>
            </div>

            <div className="card">
              <div className="card-title">Opções Finais</div>
              <label className="check-row">
                <input type="checkbox" checked={incluirBarramento} onChange={e => setIncluirBarramento(e.target.checked)} />
                <span>
                  Incluir Barramento — {(() => {
                    const ampGeral = parseInt(disjuntorGeral.amperagem) || 0;
                    const barr = DB.barramentos.find(b => b.corrente > ampGeral) || DB.barramentos[DB.barramentos.length - 1];
                    const metros = 5;
                    const preco = metros * barr.pesoMetro * barr.precoKg;
                    return `${barr.nome} (${metros}m) — ${fmt(preco)}`;
                  })()}
                </span>
              </label>
              {tipoQuadro === "aluminio" && (
                <div style={{ marginLeft: 28, marginTop: 4, fontSize: 12, color: CORES.textMuted }}>
                  💡 Muitos QMs de alumínio já vêm com barramento incluído
                </div>
              )}
              <label className="check-row">
                <input type="checkbox" checked={incluirMO} onChange={e => setIncluirMO(e.target.checked)} />
                <span>Incluir Mão de Obra — R$ {tipoQuadro === "aluminio" ? DB.maoDeObra.aluminio : DB.maoDeObra.policarb}/medidor</span>
              </label>
            </div>

            <div className="nav-buttons">
              <button className="btn-back" onClick={() => setEtapa(2)}>← Voltar</button>
              <button className="btn-next" onClick={calcular}>⚡ Gerar Orçamento</button>
            </div>
          </>
        )}

        {/* ======================== ETAPA 4 — RESULTADO ======================== */}
        {etapa === 4 && resultado && (
          <>
            <div className="card">
              <div className="result-header">
                <div>
                  <div className="result-title">
                    {cliente.nome || "Orçamento"} — QM {tipoQuadro === "aluminio" ? "Alumínio" : "Policarbonato"}
                  </div>
                  <div className="result-subtitle">
                    {qtdMedidores} medidores · {cliente.endereco || "Sem endereço"}
                  </div>
                </div>
                <button className="btn-print" onClick={() => window.print()}>🖨 Imprimir</button>
              </div>

              <div className="price-cards">
                <div className="price-card">
                  <label>Custo Total</label>
                  <div className="value">{fmt(resultado.custoTotal)}</div>
                </div>
                <div className="price-card">
                  <label>Venda sem NF (×1.30)</label>
                  <div className="value">{fmt(resultado.vendaSemNF)}</div>
                </div>
                <div className="price-card highlight">
                  <label>Venda com NF (×1.55)</label>
                  <div className="value">{fmt(resultado.vendaComNF)}</div>
                </div>
              </div>

              <div className="sep" />

              {/* TABELA POR CATEGORIA */}
              {categorias.map(cat => (
                <div className="cat-section" key={cat}>
                  <div className="cat-header">{cat}</div>
                  <table className="itens-table">
                    <thead>
                      <tr>
                        <th>Item</th>
                        <th>Qtd.</th>
                        <th>Unit.</th>
                        <th style={{ textAlign: "right" }}>Total</th>
                      </tr>
                    </thead>
                    <tbody>
                      {resultado.itens
                        .filter(i => i.categoria === cat)
                        .map((item, idx) => (
                          <tr key={idx}>
                            <td>{item.nome}</td>
                            <td className="qty-mono">{item.qty % 1 === 0 ? item.qty : item.qty.toFixed(2)}</td>
                            <td className="qty-mono">{fmt(item.precoUnit)}</td>
                            <td className="preco-total">{fmt(item.precoTotal)}</td>
                          </tr>
                        ))}
                    </tbody>
                  </table>
                </div>
              ))}

              <div className="sep" />

              {/* TOTAL FINAL */}
              <table className="itens-table">
                <tbody>
                  <tr>
                    <td colSpan={3} style={{ fontWeight: 700 }}>CUSTO TOTAL</td>
                    <td className="preco-total" style={{ fontSize: 16 }}>{fmt(resultado.custoTotal)}</td>
                  </tr>
                  <tr>
                    <td colSpan={3} style={{ color: CORES.textMuted }}>Venda sem NF (×1.30)</td>
                    <td className="preco-total">{fmt(resultado.vendaSemNF)}</td>
                  </tr>
                  <tr>
                    <td colSpan={3} style={{ color: CORES.accent, fontWeight: 700 }}>Venda com NF (×1.55)</td>
                    <td className="preco-total" style={{ color: CORES.accent }}>{fmt(resultado.vendaComNF)}</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div className="nav-buttons">
              <button className="btn-back" onClick={() => setEtapa(3)}>← Editar</button>
              <button className="btn-next" onClick={() => { setEtapa(1); setResultado(null); setMedidores([]); }}>
                ＋ Novo Orçamento
              </button>
            </div>
          </>
        )}
      </div>
    </>
  );
}
