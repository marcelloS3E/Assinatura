// ============================================================
// FUNÇÕES DE CÁLCULO
// ============================================================
function calcularOrcamento(config) {
  const {
    tipoQuadro, // 'aluminio' | 'policarb'
    qtdMedidores,
    disjuntorGeral, // { tipo: 'din'|'cm', amperagem: '80A', qty: 1 }
    medidores,      // [{ tipo: 'mono'|'bi'|'tri', amperagem: '50A', qty: 2 }, ...]
    dps,            // '' | 'classeI' | 'classeII'
    incluirBarramento, // true/false - se deve incluir barramento automático
    incluirMO,
  } = config;

  let itens = {}; // id -> { nome, categoria, qty, precoUnit, precoTotal }
  const add = (id, nome, categoria, qty, precoUnit) => {
    if (!itens[id]) itens[id] = { nome, categoria, qty: 0, precoUnit, precoTotal: 0 };
    itens[id].qty += qty;
    itens[id].precoTotal = itens[id].qty * precoUnit;
  };

  // 1. CAIXA PRINCIPAL
  if (tipoQuadro === "aluminio") {
    const cx = DB.caixasAluminio.find(c => c.medidores >= qtdMedidores) || DB.caixasAluminio[DB.caixasAluminio.length - 1];
    add("cx_alum", `QM Alumínio ${cx.medidores} medidores`, "Caixas", 1, cx.preco * 1.25);
  } else {
    // POLICARBONATO
    add("cx_bep_dps", DB.caixasPolicarb.bepDps.nome, "Caixas", 1, DB.caixasPolicarb.bepDps.preco);
    add("cx_med",     DB.caixasPolicarb.medidor.nome, "Caixas", qtdMedidores, DB.caixasPolicarb.medidor.preco);
    
    // Lógica das caixas especiais conforme disjuntor geral
    const ampGeral = parseInt(disjuntorGeral.amperagem) || 0;
    if (ampGeral <= 70) {
      // Até 70A: Cx Barramento + Cx Disj Geral
      add("cx_disj", DB.caixasPolicarb.disjGeral.nome, "Caixas", 1, DB.caixasPolicarb.disjGeral.preco);
      // Cx Barramento será adicionada se usar barramento 100A ou 200A (mais adiante)
    } else if (ampGeral <= 100) {
      // >70A até 100A: 2 Caixas Especiais (substituem cx barramento + disj geral)
      add("cx_especial", DB.caixasPolicarb.especial.nome, "Caixas", 2, DB.caixasPolicarb.especial.preco);
    } else {
      // >100A: 3 Caixas Especiais
      add("cx_especial", DB.caixasPolicarb.especial.nome, "Caixas", 3, DB.caixasPolicarb.especial.preco);
    }
  }

  // 2. DISJUNTOR GERAL
  if (disjuntorGeral.tipo && disjuntorGeral.amperagem) {
    const precoDisj = DB.disjuntores[disjuntorGeral.tipo]?.[disjuntorGeral.amperagem] || 0;
    if (precoDisj > 0) {
      add(`disj_${disjuntorGeral.tipo}_${disjuntorGeral.amperagem}`,
        `Disj. ${disjuntorGeral.tipo.toUpperCase()} ${disjuntorGeral.amperagem}`,
        "Disjuntores", disjuntorGeral.qty || 1, precoDisj);
    }
    
    // BARRAMENTO AUTOMÁTICO (5m total: 3 fases + neutro + terra)
    // Seleciona barramento com capacidade ESTRITAMENTE MAIOR que a corrente do disjuntor
    const ampGeral = parseInt(disjuntorGeral.amperagem) || 0;
    const barramentoSelecionado = DB.barramentos.find(b => b.corrente > ampGeral) 
      || DB.barramentos[DB.barramentos.length - 1]; // fallback: maior barramento
    
    if (barramentoSelecionado && incluirBarramento) {
      const metrosTotal = 5; // 3 fases + neutro + terra
      const pesoTotal = metrosTotal * barramentoSelecionado.pesoMetro;
      const precoTotal = pesoTotal * barramentoSelecionado.precoKg;
      
      add(`barramento_auto`,
        `${barramentoSelecionado.nome} (${metrosTotal}m)`,
        "Barramentos", 1, precoTotal);
    }
    
    // Cabos do disjuntor geral
    const regrasCG = DB.regrasCabos[disjuntorGeral.tipo]?.[disjuntorGeral.amperagem] || {};
    const olhaisCG = DB.regrasOlhais[disjuntorGeral.tipo]?.[disjuntorGeral.amperagem] || {};
    const qtyCG = disjuntorGeral.qty || 1;
    Object.entries(regrasCG).forEach(([secao, info]) => {
      const qtyCabo = info.cores.length * info.fator * qtyCG;
      add(`cabo_${secao}`, `Cabo ${secao}`, "Cabos", qtyCabo, DB.cabos[secao] || 0);
      add(`termo_${secao}`, `Termocontrátil ${secao}`, "Termocontrátil", qtyCabo * 0.1, DB.termo[secao] || 0);
    });
    Object.entries(olhaisCG).forEach(([secao, fator]) => {
      add(`olhal_${secao}`, `Olhal ${secao}`, "Olhais", fator * qtyCG, DB.olhais[secao] || 0);
    });
  }

  // 3. MEDIDORES (unidades consumidoras)
  medidores.forEach(m => {
    if (!m.tipo || !m.amperagem || !m.qty) return;
    const precoDisj = DB.disjuntores[m.tipo]?.[m.amperagem] || 0;
    if (precoDisj > 0) {
      add(`disj_${m.tipo}_${m.amperagem}`,
        `Disj. ${m.tipo.toUpperCase()} ${m.amperagem}`,
        "Disjuntores", m.qty, precoDisj);
    }
    // Cabos
    const regras = DB.regrasCabos[m.tipo]?.[m.amperagem] || {};
    const olhais = DB.regrasOlhais[m.tipo]?.[m.amperagem] || {};
    Object.entries(regras).forEach(([secao, info]) => {
      const qtyCabo = info.cores.length * info.fator * m.qty;
      add(`cabo_${secao}`, `Cabo ${secao}`, "Cabos", qtyCabo, DB.cabos[secao] || 0);
      add(`termo_${secao}`, `Termocontrátil ${secao}`, "Termocontrátil", qtyCabo * 0.1, DB.termo[secao] || 0);
    });
    Object.entries(olhais).forEach(([secao, fator]) => {
      add(`olhal_${secao}`, `Olhal ${secao}`, "Olhais", fator * m.qty, DB.olhais[secao] || 0);
    });
    
    // Plaquetas, abraçadeiras e conectores (em AMBOS os tipos de QM)
    add("plaqueta", DB.outros.plaqueta.nome, "Outros", m.tipo === "tri" ? 2 * m.qty : 2 * m.qty, DB.outros.plaqueta.preco);
    add("abrac",    DB.outros.abrac.nome,    "Outros", m.tipo === "tri" ? 20 * m.qty : 20 * m.qty, DB.outros.abrac.preco);
    add("conector", DB.outros.conector.nome, "Outros", m.qty, DB.outros.conector.preco);
    
    // APENAS PARA POLICARBONATO: Box, parafusos, porcas, arruelas, rebites, barramento pente
    if (tipoQuadro === "policarb") {
      add("box_1.5", "Conjunto Box 1.1/2\"", "Eletrodutos", m.qty, DB.box["1.1/2\""]);
      add("porca",    DB.outros.porca.nome,    "Outros", m.tipo === "tri" ? 12 * m.qty : 12 * m.qty, DB.outros.porca.preco);
      add("arruela",  DB.outros.arruela.nome,  "Outros", m.tipo === "tri" ? 12 * m.qty : 12 * m.qty, DB.outros.arruela.preco);
      add("parafuso", DB.outros.parafuso.nome, "Outros", m.tipo === "tri" ? 12 * m.qty : 12 * m.qty, DB.outros.parafuso.preco);
      add("rebite",   DB.outros.rebite.nome,   "Outros", m.tipo === "tri" ? 4 * m.qty  : 4 * m.qty,  DB.outros.rebite.preco);
      add("barra_pente", DB.outros.barramentoPente.nome, "Outros", m.qty, DB.outros.barramentoPente.preco);
    }
  });

  // 4. DPS — 3 módulos + 3 disjuntores mono (um por fase), fixo por quadro
  if (dps) {
    const dpsCfg = DB.dps[dps];
    const metroCaboTotal = dpsCfg.metroCabo * dpsCfg.qtdModulo; // 0.3m × 3 = 0.9m
    add(`cabo_dps_${dps}`,
        `Cabo ${dpsCfg.cabo} verde (DPS)`,
        "DPS", metroCaboTotal, dpsCfg.precoCabo);
    add(`disj_dps_${dps}`,
        `Disj. Mono ${dpsCfg.disjAmp} 10kA (DPS) — 3 fases`,
        "DPS", dpsCfg.qtdDisj, dpsCfg.precoDisj);
    add(`mod_dps_${dps}`,
        `Módulo DPS ${dpsCfg.modulo} — 3 fases`,
        "DPS", dpsCfg.qtdModulo, dpsCfg.precoModulo);
    if (tipoQuadro === "policarb") {
      add("cx_bep_dps2", DB.caixasPolicarb.bepDps.nome + " (DPS)", "Caixas", 1, DB.caixasPolicarb.bepDps.preco);
    }
  }

  // 5. MÃO DE OBRA
  if (incluirMO) {
    const precoMO = tipoQuadro === "aluminio" ? DB.maoDeObra.aluminio : DB.maoDeObra.policarb;
    add("mao_de_obra", `Mão de Obra (${tipoQuadro === "aluminio" ? "Alumínio" : "Policarb."})`, "Mão de Obra", qtdMedidores, precoMO);
  }

  const listaItens = Object.values(itens).filter(i => i.qty > 0 && i.precoTotal > 0);
  const custoTotal = listaItens.reduce((s, i) => s + i.precoTotal, 0);
  const vendaSemNF  = custoTotal * 1.30;
  const vendaComNF  = custoTotal * 1.55;

  return { itens: listaItens, custoTotal, vendaSemNF, vendaComNF };
}

